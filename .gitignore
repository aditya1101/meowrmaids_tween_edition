# --- Godot 4.x Core ---
# This folder contains your imported textures, meshes, and metadata. 
# It can be gigabytes in size and is recreated automatically.
.godot/

# Binary translation files generated by the editor
*.translation

# --- Asset Management ---
# We generally KEEP .import files (like arm_v65.png.import) because 
# they store your specific compression and filter settings.
# However, if you want to ignore all auto-generated UID files:
# *.uid

# --- Editor & User Config ---
# These store which scripts you had open and your window layout.
# Usually best to ignore so your teammate (or your future self) doesn't 
# have their editor layout overwritten by your commit.
.editorconfig.local
*.tmp

# --- Build & Exports ---
# Keeps your final game builds out of your source code history
build/
bin/
exports/

# --- macOS Specific (Since you're on Tahoe) ---
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# --- AI & Plugin Cache ---
# Standard locations for 2026 AI agent session data
.ziva_cache/
.gemini_session/
.cursorrules (keep this if you have custom AI rules, ignore if not)
